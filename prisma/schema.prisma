generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  PLATFORM_ADMIN
  COMPANY_ADMIN
  QC
}

enum WaterTestStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  APPROVED
  PUBLISHED
  REJECTED
  RETEST_REQUIRED
}

enum CertificateStatus {
  ISSUED
  REVOKED
  EXPIRED
}

enum NonConformanceStatus {
  OPEN
  UNDER_INVESTIGATION
  RESOLVED
  CLOSED
}

enum CorrectiveActionStatus {
  PENDING
  IN_PROGRESS
  VERIFIED
  CLOSED
}

// ---------------------------------------------------------
// CORE SYSTEM (TENANTS & USERS)
// ---------------------------------------------------------

model Organization {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(150)
  address        String?   @db.VarChar(255)
  licenseNumber  String?   @unique @db.VarChar(100)
  contactEmail   String?   @db.VarChar(150)
  contactPhone   String?   @db.VarChar(50)
  
  // Standard Fields
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?   // User ID
  updatedBy      String?   // User ID

  // Relations
  users                  User[]
  apiSubscriptions       ApiSubscription[]
  customers              Customer[]
  complianceTemplates    ComplianceTemplate[]
  nonConformanceRecords  NonConformanceRecord[]
  auditLogs              AuditLog[]

  @@index([isActive, createdAt(sort: Desc)])
  @@index([name])
}

model User {
  id             String        @id @default(cuid())
  organizationId String?       // Nullable for PLATFORM_ADMIN
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String        @db.VarChar(150)
  email          String        @unique @db.VarChar(150)
  passwordHash   String        @db.VarChar(255)
  role           Role          @default(QC)
  
  // Standard Fields
  isActive       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdBy      String?
  updatedBy      String?

  // Inverse relations for Audit
  audits         AuditLog[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, role])
  @@index([isActive, createdAt(sort: Desc)])
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       @db.VarChar(150)
  email          String?      @db.VarChar(150)
  phone          String?      @db.VarChar(50)
  address        String?      @db.VarChar(255)

  // Standard Fields
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
}

// ---------------------------------------------------------
// PRODUCTION & COMPLIANCE
// ---------------------------------------------------------

model WaterTestReport {
  id             String          @id @default(cuid())
  organizationId String
  
  batchNumber    String          @db.VarChar(100)
  sampleNumber   String?         @db.VarChar(100)
  reportType     String          @default("PACKAGED_DRINKING_WATER") @db.VarChar(100)
  
  status         WaterTestStatus @default(DRAFT)
  sampleTime     DateTime
  testedBy       String          // Name of QC person
  remarks        String?         @db.Text

  // Standard Fields
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdBy      String?
  updatedBy      String?

  // Relations
  results        WaterTestResult[]

  @@index([organizationId, sampleTime(sort: Desc)])
  @@index([organizationId, status, sampleTime(sort: Desc)])
  @@index([organizationId, createdBy, sampleTime(sort: Desc)])
  @@index([organizationId, batchNumber])
  @@index([createdBy, status])
}

model WaterTestParameter {
  id             String    @id @default(cuid())
  // Global reference parameters
  name           String    @db.VarChar(100)
  category       String    @db.VarChar(50) // CHEMISTRY, MICROBIOLOGY, etc.
  unit           String    @db.VarChar(50)
  minAcceptable  Float?
  maxAcceptable  Float?

  // Standard Fields
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  results        WaterTestResult[]

  @@index([category, name])
  @@unique([name, category])
}

model WaterTestResult {
  id               String             @id @default(cuid())
  reportId         String
  report           WaterTestReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  
  parameterId      String
  parameter        WaterTestParameter @relation(fields: [parameterId], references: [id])
  
  value            Float
  isPass           Boolean

  // Standard Fields
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  @@unique([reportId, parameterId])
  @@index([parameterId])
}

model Certificate {
  id               String            @id @default(cuid())
  organizationId   String
  
  batchNumber      String            @db.VarChar(100)
  
  certificateUrl   String?
  status           CertificateStatus @default(ISSUED)
  issuedAt         DateTime          @default(now())

  // Standard Fields
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([organizationId, issuedAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, issuedAt(sort: Desc)])
  @@index([organizationId, batchNumber])
}

model VerificationRecord {
  id               String    @id @default(cuid())
  batchNumber      String    @db.VarChar(100)
  
  scannedAt        DateTime  @default(now())
  ipAddress        String?   @db.VarChar(50)
  userAgent        String?   @db.Text
  location         String?   @db.VarChar(255)
  isValid          Boolean   @default(true)

  // Standard Fields
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([batchNumber, scannedAt(sort: Desc)])
  @@index([isValid, scannedAt(sort: Desc)])
}

// ---------------------------------------------------------
// QUALITY ASSURANCE (CAPA & NCR)
// ---------------------------------------------------------

model ComplianceTemplate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  name           String       @db.VarChar(150)
  description    String?      @db.Text
  version        String       @db.VarChar(20)

  // Standard Fields
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([organizationId, version])
}

model NonConformanceRecord {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  batchNumber    String?              @db.VarChar(100)
  
  title          String               @db.VarChar(150)
  description    String               @db.Text
  severity       String               @db.VarChar(50) // LOW, MEDIUM, HIGH, CRITICAL
  status         NonConformanceStatus @default(OPEN)

  // Standard Fields
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdBy      String?
  updatedBy      String?

  correctiveActions CorrectiveAction[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([organizationId, severity])
  @@index([organizationId, batchNumber])
  @@index([createdBy, status])
}

model CorrectiveAction {
  id               String                 @id @default(cuid())
  ncrId            String
  ncr              NonConformanceRecord   @relation(fields: [ncrId], references: [id], onDelete: Cascade)
  
  actionPlan       String                 @db.Text
  assignedTo       String?                // User ID
  dueDate          DateTime?
  status           CorrectiveActionStatus @default(PENDING)
  completionNotes  String?                @db.Text

  // Standard Fields
  isActive         Boolean                @default(true)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([ncrId])
  @@index([assignedTo, status])
  @@index([status, dueDate])
}

// ---------------------------------------------------------
// API MARKETPLACE
// ---------------------------------------------------------

model ApiProduct {
  id             String            @id @default(cuid())
  // Global objects managed by PLATFORM_ADMIN
  name           String            @db.VarChar(100)
  description    String?           @db.Text
  price          Float
  rateLimit      Int
  features       String[]

  // Standard Fields
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  createdBy      String?
  updatedBy      String?

  subscriptions  ApiSubscription[]

  @@index([isActive, price])
  @@index([createdAt(sort: Desc)])
}

model ApiSubscription {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  productId      String
  product        ApiProduct   @relation(fields: [productId], references: [id])
  
  status         String       @default("ACTIVE") @db.VarChar(50)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime

  // Standard Fields
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdBy      String?
  updatedBy      String?

  keys           ApiKey[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([productId, status])
  @@index([currentPeriodEnd])
}

model ApiKey {
  id               String          @id @default(cuid())
  organizationId   String
  
  subscriptionId   String
  subscription     ApiSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  
  name             String          @db.VarChar(100)
  keyHash          String          @unique @db.VarChar(255)
  lastUsedAt       DateTime?

  // Standard Fields
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([subscriptionId])
  @@index([lastUsedAt])
}

// ---------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  action         String        @db.VarChar(100) // CREATE, UPDATE, DELETE
  entityName     String        @db.VarChar(100) // Table Name
  entityId       String        @db.VarChar(100) // Record ID
  
  beforeValue    Json?
  afterValue     Json?
  
  ipAddress      String?       @db.VarChar(50)
  userAgent      String?       @db.Text

  // Audit logs are strictly immutable and never soft deleted.
  createdAt      DateTime      @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([entityName, entityId])
  @@index([action, createdAt(sort: Desc)])
}
